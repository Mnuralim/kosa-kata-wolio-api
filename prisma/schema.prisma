generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String    @id @default(uuid()) @map("pengguna_id")
  username  String    @map("nama_pengguna") @db.VarChar(100)
  name      String    @map("nama") @db.VarChar(255)
  password  String    @map("kata_sandi") @db.VarChar(255)
  role      Role      @default(ADMIN) @map("peran")
  isDeleted Boolean   @default(false) @map("terhapus")
  deletedAt DateTime? @map("terhapus_pada")
  createdAt DateTime  @default(now()) @map("dibuat_pada")
  updatedAt DateTime  @updatedAt @map("diperbarui_pada")

  attempts QuizAttempt[]

  @@index([username])
  @@map("pengguna")
}

model Category {
  id        String    @id @default(uuid()) @map("kategori_id")
  name      String    @unique @map("nama") @db.VarChar(255)
  isDeleted Boolean   @default(false) @map("terhapus")
  deletedAt DateTime? @map("terhapus_pada")
  createdAt DateTime  @default(now()) @map("dibuat_pada")
  updatedAt DateTime  @updatedAt @map("diperbarui_pada")

  words Word[]

  @@map("kategori")
}

model Word {
  id            String    @id @default(uuid()) @map("kata_id")
  indonesian    String    @map("bahasa_indonesia") @db.VarChar(255)
  localLanguage String    @map("bahasa_daerah") @db.VarChar(255)
  localScript   String?   @map("aksara_daerah") @db.Text
  categoryId    String    @map("kategori_id") @db.VarChar(36)
  category      Category  @relation(fields: [categoryId], references: [id])
  audios        Audio[]
  quizQuestions QuizQuestion[]
  isDeleted     Boolean   @default(false) @map("terhapus")
  deletedAt     DateTime? @map("terhapus_pada")
  createdAt     DateTime  @default(now()) @map("dibuat_pada")
  updatedAt     DateTime  @updatedAt @map("diperbarui_pada")

  @@index([indonesian])
  @@index([localLanguage])
  @@index([categoryId])
  @@map("kata")
}

model Audio {
  id        String    @id @default(uuid()) @map("audio_id")
  url       String    @map("url") @db.VarChar(500)
  wordId    String    @map("kata_id") @db.VarChar(36)
  word      Word      @relation(fields: [wordId], references: [id], onDelete: Cascade)
  isDeleted Boolean   @default(false) @map("terhapus")
  deletedAt DateTime? @map("terhapus_pada")
  createdAt DateTime  @default(now()) @map("dibuat_pada")

  @@index([wordId])
  @@map("audio")
}

model SyncMeta {
  key   String @id @map("kunci") @db.VarChar(100)
  value String @map("nilai") @db.Text

  @@map("meta_sinkronisasi")
}

enum Role {
  ADMIN
  SUPER_ADMIN
  USER
}

enum QuizLevel {
  EASY
  MEDIUM
  HARD
}

enum QuizQuestionType {
  ID_TO_LOCAL
  LOCAL_TO_ID
  SCRIPT_TO_ID
  SCRIPT_TO_LOCAL
  AUDIO_TO_ID
  AUDIO_TO_LOCAL
}

model Quiz {
  id        String    @id @default(uuid()) @map("kuis_id")
  title     String    @map("judul") @db.VarChar(255)
  level     QuizLevel @map("tingkat")
  isDeleted Boolean   @default(false) @map("terhapus")
  deletedAt DateTime? @map("terhapus_pada")
  createdAt DateTime  @default(now()) @map("dibuat_pada")
  updatedAt DateTime  @updatedAt @map("diperbarui_pada")

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([level])
  @@map("kuis")
}

model QuizQuestion {
  id        String           @id @default(uuid()) @map("soal_id")
  quizId    String           @map("kuis_id") @db.VarChar(36)
  quiz      Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  wordId    String           @map("kata_id") @db.VarChar(36)
  word      Word             @relation(fields: [wordId], references: [id])
  type      QuizQuestionType @default(ID_TO_LOCAL) @map("tipe")
  choices   Json             @map("pilihan")
  order     Int              @default(0) @map("urutan")
  isDeleted Boolean          @default(false) @map("terhapus")
  deletedAt DateTime?        @map("terhapus_pada")
  createdAt DateTime         @default(now()) @map("dibuat_pada")

  attemptAnswers QuizAttemptAnswer[]

  @@index([quizId])
  @@map("soal_kuis")
}

model QuizAttempt {
  id         String   @id @default(uuid()) @map("riwayat_id")
  userId     String   @map("pengguna_id") @db.VarChar(36)
  user       User     @relation(fields: [userId], references: [id])
  quizId     String   @map("kuis_id") @db.VarChar(36)
  quiz       Quiz     @relation(fields: [quizId], references: [id])
  score      Int      @default(0) @map("skor")
  total      Int      @default(0) @map("total")
  startedAt  DateTime @default(now()) @map("dimulai_pada")
  finishedAt DateTime @default(now()) @map("selesai_pada")

  answers QuizAttemptAnswer[]

  @@index([userId])
  @@index([quizId])
  @@map("riwayat_kuis")
}

model QuizAttemptAnswer {
  id            String      @id @default(uuid()) @map("jawaban_id")
  attemptId     String      @map("riwayat_id") @db.VarChar(36)
  attempt       QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String      @map("soal_id") @db.VarChar(36)
  question      QuizQuestion @relation(fields: [questionId], references: [id])
  answer        String      @map("jawaban") @db.VarChar(255)
  correctAnswer String      @map("jawaban_benar") @db.VarChar(255)
  isCorrect     Boolean     @map("benar")
  answeredAt    DateTime    @default(now()) @map("dijawab_pada")

  @@index([attemptId])
  @@index([questionId])
  @@map("riwayat_jawaban")
}
